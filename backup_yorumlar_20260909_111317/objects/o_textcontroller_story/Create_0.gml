dialogue = [
	{time:  135, bit:  408, text: "Below stone and shadow,&lived a legendary race&of Monsters."},
	{time:  471, bit:  772, text: "Fear swept the land as&the final human struck&the rocky surface below."},
	{time:  835, bit: 1103, text: "Papyrus felt his stomach&churn at the lone piles&of dust."},
	{time: 1166, bit: 1454, text: "After convincing Sans&that they already made it&past Waterfall..."},
	{time: 1517, bit: 1768, text: "He hurried off,&determination flaring in&his eyes."},
	{time: 1831, bit: 2074, text: "Papyrus stayed, hoping&to overpower the human."},
	{time: 2137, bit: 2358, text: "Or at least come to an&understanding."},
	{time: 2725, bit: 3021, text: "Waterfall offered&nothing, so Sans made his&way back to the village."},
	{time: 3084, bit: 3315, text: "The fiery remains of&his brother were all&that met his gaze."},
	{time: 3315, bit: 3558, text: "His icy glare began to&melt, little by little."},
	{time: 3621, bit: 3879, text: "Donning his brother's&signature jacket, he&recalled his Guard's mantra:"},
	{time: 3879, bit: 4090, text: "Be relentless in your&pursuit of that which&is good."},
	{time: 4090, bit: 4281, text: "To uphold Justice, you&must show Integrity."},
	{time: 4281, bit: 4444, text: "Integrity is rooted in&Kindness."},
	{time: 4444, bit: 4617, text: "Kindness grows through&Perseverance."},
	{time: 4617, bit: 4925, text: "And Perseverance teaches&the Patience necessary to&withstand every trial."},
	{time: 4970, bit: 5153, text: "So stand tall, with your&head held high."},
	{time: 5153, bit: 5421, text: "For now you must decide&whether you're willing to&hold true to these words."},
	{time: 5421, bit: 5652, text: "The question is..."},
	{time: 5677, bit: 6509, text: "...are you?"},
];
current_line = -1;
