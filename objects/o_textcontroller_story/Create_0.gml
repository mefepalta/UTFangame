dialogue = [
    {time: 300,  text: "Below stone and shadow,&lived a legendary race&of Monsters."},
    {time: 720,  text: "Fear swept the land as&the final human struck&the rocky surface below."},
    {time: 980,  text: "Papyrus felt his stomach&churn at the lone piles&of dust."},
    {time: 1200, text: "After convincing Sans&that they already made it&past Waterfall..."},
    {time: 1450, text: "He hurried off,&determination flaring in&his eyes."},
    {time: 1750, text: "Papyrus stayed, hoping&to overpower the human."},
    {time: 1950, text: "Or at least come to an&understanding."},
    {time: 2250, text: "Waterfall offered&nothing, so Sans made his&way back to the village."},
    {time: 2950, text: "The fiery remains of&his brother were all&that met his gaze."},
    {time: 3200, text: "His icy glare began to&melt, little by little."},
    {time: 3450, text: "Donning his brother's&signature jacket, he&recalled his Guard's mantra:"},
    {time: 3650, text: "Be relentless in your&pursuit of that which&is good."},
    {time: 4150, text: "To uphold Justice, you&must show Integrity."},
    {time: 4650, text: "Integrity is rooted in&Kindness."},
    {time: 5500, text: "Kindness grows through&Perseverance."},
    {time: 5750, text: "And Perseverance teaches&the Patience necessary to&withstand every trial."},
	{time: 5750, text: "So stand tall, with your&head held high."},
	{time: 5750, text: "For now you must decide&whether you're willing to&hold true to these words."},
	{time: 5750, text: "The question is..."},
	{time: 5750, text: "...are you?"}
];
current_line = -1;
